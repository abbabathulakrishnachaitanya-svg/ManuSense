# ManuSense — Environment Configuration Template
# Copy this file to .env and fill in your values.
# Never commit .env to Git.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── Data paths ────────────────────────────────────────────────────────────────
DATA_DIR=data
IMAGES_DIR=data/images
PROCESSED_DIR=data/processed
MODELS_DIR=models

# Dataset root — organizer inspection images (real data, ImageFolder layout)
# Structure: train/<class_name>/*.png
# Classes:   crack | hole | normal | rust | scratch
TRAIN_DIR=train

# ── Vision model ─────────────────────────────────────────────────────────────
MODEL_NAME=resnet18                    # resnet18 | mobilenet_v3_small
MODEL_WEIGHTS_PATH=models/best_model.pt
IMAGE_SIZE=224                         # square input resolution
NUM_CLASSES=5                          # crack | hole | normal | rust | scratch

# ── Training hyperparameters ─────────────────────────────────────────────────
TRAIN_VAL_SPLIT=0.8                    # fraction used for training (rest = validation)
RANDOM_SEED=42                         # reproducible splits and weight init
BATCH_SIZE=32
NUM_EPOCHS=15
LEARNING_RATE=0.001
NUM_WORKERS=0                          # set > 0 on Linux/macOS for faster loading

# ── Decision thresholds ───────────────────────────────────────────────────────
# These are initial prototype values — not claims of optimality.
# Calibrate against your validation confusion matrix and cost of errors.
#
#   confidence >= CONFIDENCE_THRESHOLD  AND class = "normal"  → ACCEPT
#   confidence >= CONFIDENCE_THRESHOLD  AND class ≠ "normal"  → REJECT
#   confidence <  UNCERTAINTY_THRESHOLD                        → REVIEW
#   between the two thresholds                                 → REVIEW
CONFIDENCE_THRESHOLD=0.80
UNCERTAINTY_THRESHOLD=0.50

# ── Economics ────────────────────────────────────────────────────────────────
# Fill in from real data when available.
# Current analytics modules use synthetic demonstration values.
CURRENCY=USD
COST_PER_DEFECT=0.0
REVENUE_PER_UNIT=0.0
